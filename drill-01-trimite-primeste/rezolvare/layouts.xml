<!-- ===== res/layout/activity_main.xml ===== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnAdauga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adaugă film" />

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>

<!-- ===== res/layout/activity_add_film.xml ===== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etTitlu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Titlu" />

    <EditText
        android:id="@+id/etAn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="An"
        android:inputType="number" />

    <Button
        android:id="@+id/btnTrimite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trimite" />
</LinearLayout>

<!-- ===== res/layout/activity_detalii_film.xml ===== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDetalii"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>

<!-- Notă: în drill am scos blocul EdgeToEdge/ViewCompat ca să ai mai puțin cod;
     fitsSystemWindows="true" evită suprapunerea cu status bar-ul (ca în Seminarele 4-6).
     Textele sunt hardcodate doar pentru viteză — la test, strings.xml. -->
